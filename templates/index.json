t(3, minmax(170px, 1fr));\n    align-items: stretch;\n  }\n\n  #crinea-comparison .crinea-comparison__column-head {\n    min-height: 145px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 14px;\n    text-align: center;\n  }\n\n  #crinea-comparison .crinea-comparison__column-head--empty {\n    background: transparent;\n  }\n\n  #crinea-comparison .crinea-comparison__column-head--featured {\n    border-radius: 18px 18px 0 0;\n    background: var(--crinea-pink);\n  }\n\n  #crinea-comparison .crinea-comparison__product {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 9px;\n  }\n\n  #crinea-comparison .crinea-comparison__product-image-box {\n    width: 84px;\n    height: 76px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    border-radius: 8px;\n    background: #ffffff;\n  }\n\n  #crinea-comparison .crinea-comparison__product-image {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: contain;\n  }\n\n  #crinea-comparison .crinea-comparison__product-name {\n    margin: 0;\n    color: var(--crinea-dark);\n    font-size: 14px;\n    font-weight: 800;\n    line-height: 1.2;\n  }\n\n  #crinea-comparison .crinea-comparison__row {\n    min-height: 84px;\n  }\n\n  #crinea-comparison .crinea-comparison__cell {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 0;\n    padding: 14px 18px;\n    border-top: 1px solid var(--crinea-line);\n    text-align: center;\n  }\n\n  #crinea-comparison .crinea-comparison__cell--label {\n    justify-content: flex-start;\n    color: var(--crinea-dark);\n    font-size: 17px;\n    font-weight: 750;\n    line-height: 1.3;\n    text-align: left;\n  }\n\n  #crinea-comparison .crinea-comparison__cell--featured {\n    border-top-color: rgba(255, 255, 255, 0.52);\n    background: var(--crinea-pink);\n  }\n\n  #crinea-comparison\n    .crinea-comparison__row:last-child\n    .crinea-comparison__cell--featured {\n    border-radius: 0 0 18px 18px;\n  }\n\n  #crinea-comparison .crinea-comparison__icon {\n    width: 50px;\n    height: 50px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 50px;\n    border-radius: 50%;\n    font-family: Arial, sans-serif;\n    font-size: 30px;\n    font-weight: 800;\n    line-height: 1;\n  }\n\n  #crinea-comparison .crinea-comparison__icon--featured {\n    background: #ffffff;\n    color: var(--crinea-pink);\n  }\n\n  #crinea-comparison .crinea-comparison__icon--yes {\n    background: var(--crinea-pink);\n    color: #ffffff;\n  }\n\n  #crinea-comparison .crinea-comparison__icon--no {\n    background: var(--crinea-red);\n    color: #ffffff;\n  }\n\n  #crinea-comparison .crinea-comparison__price {\n    color: var(--crinea-dark);\n    font-size: 17px;\n    font-weight: 800;\n    line-height: 1.3;\n  }\n\n  #crinea-comparison .crinea-comparison__price strong {\n    display: block;\n    font-size: 19px;\n  }\n\n  #crinea-comparison .crinea-comparison__note {\n    max-width: 760px;\n    margin: 25px auto 0;\n    color: #87756c;\n    font-size: 11px;\n    line-height: 1.5;\n    text-align: center;\n  }\n\n  @media screen and (max-width: 749px) {\n    #crinea-comparison {\n      padding: 48px 14px;\n    }\n\n    #crinea-comparison .crinea-comparison__header {\n      margin-bottom: 28px;\n    }\n\n    #crinea-comparison .crinea-comparison__title {\n      font-size: 34px;\n      letter-spacing: -0.8px;\n    }\n\n    #crinea-comparison .crinea-comparison__subtitle {\n      font-size: 21px;\n    }\n\n    #crinea-comparison .crinea-comparison__scroll {\n      margin-right: -14px;\n      padding-right: 14px;\n    }\n\n    #crinea-comparison .crinea-comparison__table {\n      min-width: 790px;\n    }\n\n    #crinea-comparison .crinea-comparison__grid {\n      grid-template-columns:\n        minmax(235px, 1.55fr)\n        repeat(3