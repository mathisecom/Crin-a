    "custom_liquid_WqfAAf": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<style>\n  .crinea-steps-section {\n    width: 100%;\n    padding: 50px 20px 60px;\n    background: #f4f4f4;\n    font-family: inherit;\n  }\n\n  .crinea-steps-container {\n    max-width: 1250px;\n    margin: 0 auto;\n  }\n\n  .crinea-steps-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 34px;\n  }\n\n  .crinea-step-card {\n    min-width: 0;\n  }\n\n  .crinea-step-image-wrap {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    border: 1px solid #d7d7d7;\n    border-radius: 6px;\n    overflow: hidden;\n    background: #ffffff;\n    margin-bottom: 20px;\n  }\n\n  .crinea-step-image {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n  }\n\n  .crinea-step-badge {\n    position: absolute;\n    top: 0;\n    left: 0;\n    background: #f59ac0;\n    color: #ffffff;\n    font-size: 14px;\n    font-weight: 700;\n    line-height: 1;\n    padding: 10px 16px;\n    border-bottom-right-radius: 18px;\n  }\n\n  .crinea-step-title {\n    margin: 0 0 10px;\n    color: #131a4b;\n    font-size: 28px;\n    line-height: 1.15;\n    font-weight: 800;\n    letter-spacing: -0.5px;\n  }\n\n  .crinea-step-text {\n    margin: 0;\n    color: #1e285f;\n    font-size: 17px;\n    line-height: 1.45;\n    font-weight: 400;\n  }\n\n  @media screen and (max-width: 1200px) {\n    .crinea-steps-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 28px;\n    }\n\n    .crinea-step-title {\n      font-size: 24px;\n    }\n\n    .crinea-step-text {\n      font-size: 16px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .crinea-steps-section {\n      padding: 35px 14px 40px;\n    }\n\n    .crinea-steps-grid {\n      grid-template-columns: 1fr;\n      gap: 24px;\n    }\n\n    .crinea-step-image-wrap {\n      margin-bottom: 16px;\n    }\n\n    .crinea-step-badge {\n      font-size: 13px;\n      padding: 9px 14px;\n    }\n\n    .crinea-step-title {\n      font-size: 22px;\n      margin-bottom: 8px;\n    }\n\n    .crinea-step-text {\n      font-size: 15px;\n      line-height: 1.5;\n    }\n  }\n</style>\n\n<section class=\"crinea-steps-section\">\n  <div class=\"crinea-steps-container\">\n\n    <div class=\"crinea-steps-grid\">\n\n      <!-- Étape 1 -->\n      <div class=\"crinea-step-card\">\n        <div class=\"crinea-step-image-wrap\">\n          <div class=\"crinea-step-badge\">Étape 1</div>\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_46_imgi_146_G7A6853.jpg?v=1785582333\"\n            alt=\"Étape 1 Crinéa\"\n            class=\"crinea-step-image\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"600\"\n          >\n        </div>\n\n        <h3 class=\"crinea-step-title\">Choisissez la tête</h3>\n        <p class=\"crinea-step-text\">\n          La tête de coupe centrale en aluminium capture les poils courts et\n          les coupe au ras de la peau. L’aluminium ultra-fin garantit une peau\n          parfaitement lisse et sans irritation.\n        </p>\n      </div>\n\n      <!-- Étape 2 -->\n      <div class=\"crinea-step-card\">\n        <div class=\"crinea-step-image-wrap\">\n          <div class=\"crinea-step-badge\">Étape 2</div>\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_51_G7A6879_631a1d22-ef0d-4f70-8f32-e5cfae1c0c05.jpg?v=1785582381\"\n            alt=\"Étape 2 Crinéa\"\n            class=\"crinea-step-image\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"600\"\n          >\n        </div>\n\n        <h3 class=\"crinea-step-title\">Tondeuse</h3>\n        <p class=\"crinea-step-text\">\n          Les deux têtes de tondeuse de précision s’attaquent d’abord aux\n          poils les plus longs ou les plus épais. Elles préparent la peau pour\n          un rasage ensuite doux et sans effort.\n        </p>\n      </div>\n\n      <!-- Étape 3 -->\n      <div class=\"crinea-step-card\">\n        <div class=\"crinea-step-image-wrap\">\n          <div class=\"crinea-step-badge\">Étape 3</div>\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_47_hf_20260407_041712_8b838bc2-3c59-4940-89b3-9b9a1bc9f445.png?v=1785582351\"\n            alt=\"Étape 3 Crinéa\"\n            class=\"crinea-step-image\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"600\"\n          >\n        </div>\n\n        <h3 class=\"crinea-step-title\">Feuille lisse</h3>\n        <p class=\"crinea-step-text\">\n          Sa tête rotative arrondie épouse les courbes. Utilisez-la en\n          mouvements circulaires sur le maillot, les aisselles ou toute zone\n          sensible pour un rasage impeccable sans coupures.\n        </p>\n      </div>\n\n      <!-- Étape 4 -->\n      <div class=\"crinea-step-card\">\n        <div class=\"crinea-step-image-wrap\">\n          <div class=\"crinea-step-badge\">Étape 4</div>\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_48_freecompress-G7A6773_84d43164-79ac-4c54-8e6e-6ef8194a60a7.jpg?v=1785582364\"\n            alt=\"Étape 4 Crinéa\"\n            class=\"crinea-step-image\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"600\"\n          >\n        </div>\n\n        <h3 class=\"crinea-step-title\">Rotatif pour un toucher doux et délicat</h3>\n        <p class=\"crinea-step-text\">\n          La tête rotative douce glisse sur les courbes, offrant un rasage\n          lisse et sans coupures sur les zones délicates avec une précision\n          sans effort.\n        </p>\n      </div>\n\n    </div>\n\n  </div>\n</section>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
