 #crinea-essentiels .crinea-card-title {\n    margin: 0 0 8px;\n    color: #2f201b;\n    font-size: 18px;\n    font-weight: 700;\n    line-height: 1.25;\n  }\n\n  #crinea-essentiels .crinea-card-text {\n    margin: 0;\n    color: #71625b;\n    font-size: 13px;\n    line-height: 1.6;\n  }\n\n  #crinea-essentiels .crinea-badge {\n    position: absolute;\n    top: 14px;\n    right: 14px;\n    padding: 5px 10px;\n    border-radius: 50px;\n    background: #e9f7df;\n    color: #289b11;\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: 0.6px;\n    line-height: 1;\n    text-transform: uppercase;\n  }\n\n  @media screen and (max-width: 990px) {\n    #crinea-essentiels .crinea-top-grid,\n    #crinea-essentiels .crinea-bottom-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media screen and (max-width: 600px) {\n    #crinea-essentiels {\n      padding: 38px 14px;\n    }\n\n    #crinea-essentiels .crinea-header {\n      margin-bottom: 25px;\n    }\n\n    #crinea-essentiels .crinea-main-title {\n      font-size: 28px;\n    }\n\n    #crinea-essentiels .crinea-subtitle {\n      font-size: 14px;\n    }\n\n    #crinea-essentiels .crinea-top-grid,\n    #crinea-essentiels .crinea-bottom-grid {\n      grid-template-columns: 1fr;\n      gap: 14px;\n    }\n\n    #crinea-essentiels .crinea-top-grid {\n      margin-bottom: 14px;\n    }\n\n    #crinea-essentiels .crinea-card,\n    #crinea-essentiels .crinea-card--small {\n      min-height: auto;\n      padding: 18px;\n    }\n\n    #crinea-essentiels .crinea-image-wrap {\n      height: 76px;\n      margin-bottom: 10px;\n    }\n\n    #crinea-essentiels .crinea-image {\n      width: 90px;\n      height: 74px;\n    }\n\n    #crinea-essentiels .crinea-card-title {\n      font-size: 17px;\n    }\n\n    #crinea-essentiels .crinea-card-text {\n      font-size: 12px;\n    }\n  }\n</style>\n\n<section id=\"crinea-essentiels\">\n  <div class=\"crinea-container\">\n\n    <div class-essentiels .crinea-image {\n      width: 90px;\n      height: 74px;\n    }\n\n    #crinea-essentiels .crinea-card=\"crinea-header\">\n      <h2 class=\"crinea-main-title\">\n        Découvrez les essentiels de\n        <strong>Crinéa</strong>\n      </h2>\n\n      <p class=\"crinea-subtitle\">\n        Tout ce dont vous avez besoin pour une routine complète, douce et pratique.\n      </p>\n    </div>\n\n    <!-- PREMIÈRE LIGNE -->\n    <div class=\"crinea-top-grid\">\n\n      <!-- RASOIR -->\n      <article class=\"crinea-card\">\n        <div class=\"crinea-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/rasoir_crinea.png?v=1785581729\"\n            alt=\"Rasoir Crinéa\"\n            class=\"crinea-image\"\n            loading=\"lazy\"\n            width=\"220\"\n            height=\"220\"\n          >\n        </div>\n\n        <h3 class=\"crinea-card-title\">\n          Rasoir Crinéa\n        </h3>\n\n        <p class=\"crinea-card-text\">\n          Conçu pour un rasage doux, précis et confortable sur le corps\n          et les zones les plus sensibles.\n        </p>\n      </article>\n\n      <!-- TÊTE DE RASAGE -->\n      <article class=\"crinea-card\">\n        <div class=\"crinea-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/lame.png?v=1785581749\"\n            alt=\"Tête de rasage pour le corps Crinéa\"\n            class=\"crinea-image\"\n            loading=\"lazy\"\n            width=\"220\"\n            height=\"220\"\n          >\n        </div>\n\n        <h3 class=\"crinea-card-title\">\n          Tête de rasage pour le corps\n        </h3>\n\n        <p class=\"crinea-card-text\">\n          Raccourcit les poils et offre une finition nette sur les jambes,\n          les aisselles et les zones sensibles.\n        </p>\n      </article>\n\n      <!-- CHARGEUR USB -->\n      <article class=\"crinea-card\">\n        <div class=\"crinea-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/chargeur_usb.png?v=1785581719\"\n            alt=\"Câble de chargement USB Crinéa\"\n            class=\"crinea-image\"\n            loading=\"lazy\"\n            width=\"220\"\n            height=\"220\"\n          >\n        </div>\n\n        <h3 class=\"crinea-card-title\">\n          Câble de chargement USB\n        </h3>\n\n        <p class=\"crinea-card-text\">\n          Rechargez facilement votre rasoir à la maison ou en déplacement\n          grâce au câble USB inclus.\n        </p>\n      </article>\n\n    </div>\n\n    <!-- DEUXIÈME LIGNE -->\n    <div class=\"crinea-bottom-grid\">\n\n      <!-- TÊTE VISAGE -->\n      <article class=\"crinea-card crinea-card--small\">\n        <span class=\"crinea-badge\">\n          Offerte\n        </span>\n\n        <div class=\"crinea-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/1.png?v=1785572894\"\n            alt=\"Tête pour le visage Crinéa offerte\"\n            class=\"crinea-image\"\n            loading=\"lazy\"\n            width=\"220\"\n            height=\"220\"\n          >\n        </div>\n\n        <h3 class=\"crinea-card-title\">\n          Tête pour le visage\n        </h3>\n\n        <p class=\"crinea-card-text\">\n          Idéale pour les petites zones et les finitions délicates,\n          avec une utilisation précise et confortable.\n        </p>\n      </article>\n\n      <!-- PROTECTION DE LA PEAU -->\n      <article class=\"crinea-card crinea-card--small\">\n        <span class=\"crinea-badge\">\n          Offerte\n        </span>\n\n        <div class=\"crinea-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/protection_de_peau.jpg?v=1785582050\"\n            alt=\"Protection de la peau Crinéa offerte\"\n            class=\"crinea-image\"\n            loading=\"lazy\"\n            width=\"220\"\n            height=\"220\"\n          >\n        </div>\n\n        <h3 class=\"crinea-card-title\">\n          Protection de la peau\n        </h3>\n\n        <p class=\"crinea-card-text\">\n          Aide à protéger les zones sensibles et à limiter les frottements\n          pendant le rasage.\n        </p>\n      </article>\n\n      <!-- GANT EXFOLIANT -->\n      <article class=\"crinea-card crinea-card--small\">\n        <span class=\"crinea-badge\">\n          Offert\n        </span>\n\n        <div class=\"crinea-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/2.png?v=1785572908\"\n            alt=\"Gant exfoliant Crinéa offert\"\n            class=\"crinea-image\"\n            loading=\"lazy\"\n            width=\"220\"\n            height=\"220\"\n          >\n        </div>\n\n        <h3 class=\"crinea-card-title\">\n          Gant exfoliant\n        </h3>\n\n        <p class=\"crinea-card-text\">\n          Élimine délicatement les cellules mortes et prépare la peau\n          avant chaque rasage.\n        </p>\n      </article>\n\n      <!-- BROSSE -->\n      <article class=\"crinea-card crinea-card--small\">\n        <span class=\"crinea-badge\">\n          Offerte\n        </span>\n\n        <div class=\"crinea-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/brosse_nettoyage.png?v=1785581739\"\n            alt=\"Brosse de nettoyage Crinéa offerte\"\n            class=\"crinea-image\"\n            loading=\"lazy\"\n            width=\"220\"\n            height=\"220\"\n          >\n        </div>\n\n        <h3 class=\"crinea-card-title\">\n          Brosse de nettoyage\n        </h3>\n\n        <p class=\"crinea-card-text\">\n          Retire facilement les poils et les résidus afin de simplifier\n          l’entretien du rasoir après chaque utilisation.\n        </p>\n      </article>\n\n    </div>\n\n  </div>\n</section>",
