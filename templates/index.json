ortant;\n  }\n\n  #crinea-comparison .crinea-comparison__column-head--featured {\n    border-radius: 9px 9px 0 0 !important;\n  }\n\n  #crinea-comparison .crinea-comparison__product {\n    width: 100% !important;\n    min-width: 0 !important;\n    gap: 2px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__product-image-box {\n    width: 34px !important;\n    height: 34px !important;\n    min-width: 34px !important;\n    margin: 0 auto !important;\n    border-radius: 3px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__product-image {\n    width: 100% !important;\n    height: 100% !important;\n    object-fit: contain !important;\n  }\n\n  #crinea-comparison .crinea-comparison__product-name {\n    display: block !important;\n    width: 100% !important;\n    max-width: 58px !important;\n    margin: 0 auto !important;\n    padding: 0 !important;\n    font-size: 6.5px !important;\n    font-weight: 800 !important;\n    line-height: 1.05 !important;\n    letter-spacing: 0 !important;\n    white-space: normal !important;\n    overflow-wrap: anywhere !important;\n  }\n\n  /* LIGNES */\n  #crinea-comparison .crinea-comparison__row {\n    width: 100% !important;\n    min-width: 0 !important;\n    min-height: 52px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__cell {\n    width: 100% !important;\n    min-width: 0 !important;\n    padding: 6px 1px !important;\n    overflow: hidden !important;\n  }\n\n  #crinea-comparison .crinea-comparison__cell--label {\n    justify-content: flex-start !important;\n    padding: 6px 5px !important;\n    font-size: 8.5px !important;\n    font-weight: 750 !important;\n    line-height: 1.15 !important;\n    text-align: left !important;\n    white-space: normal !important;\n    overflow-wrap: anywhere !important;\n    hyphens: auto !important;\n  }\n\n  /* CERCLES OUI / NON */\n  #crinea-comparison .crinea-comparison__icon {\n    width: 24px !important;\n    height: 24px !important;\n    min-width: 24px !important;\n    flex: 0 0 24px !important;\n    padding: 0 !important;\n    font-size: 15px !important;\n    line-height: 24px !important;\n  }\n\n  /* PRIX */\n  #crinea-comparison .crinea-comparison__price {\n    width: 100% !important;\n    padding: 0 !important;\n    font-size: 6.3px !important;\n    line-height: 1.08 !important;\n    white-space: normal !important;\n    overflow-wrap: anywhere !important;\n  }\n\n  #crinea-comparison .crinea-comparison__price strong {\n    display: block !important;\n    margin-bottom: 1px !important;\n    font-size: 7.2px !important;\n    line-height: 1.05 !important;\n  }\n\n  #crinea-comparison\n  .crinea-comparison__row:last-child\n  .crinea-comparison__cell--featured {\n    border-radius: 0 0 9px 9px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__note {\n    width: 100% !important;\n    margin: 13px auto 0 !important;\n    padding: 0 8px !important;\n    font-size: 7px !important;\n    line-height: 1.3 !important;\n  }\n}\n\n/* TRÈS PETITS TÉLÉPHONES */\n@media only screen and (max-width: 370px) {\n\n  #crinea-comparison {\n    padding-left: 2px !important;\n    padding-right: 2px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__grid {\n    grid-template-columns:\n      minmax(0, 42%)\n      minmax(0, 19.333%)\n      minmax(0, 19.333%)\n      minmax(0, 19.333%) !important;\n  }\n\n  #crinea-comparison .crinea-comparison__title {\n    font-size: 22px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__subtitle {\n    font-size: 12px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__column-head {\n    min-height: 66px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__product-image-box {\n    width: 30px !important;\n    height: 30px !important;\n    min-width: 30px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__product-name {\n    max-width: 52px !important;\n    font-size: 5.8px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__cell--label {\n    padding-left: 3px !important;\n    padding-right: 3px !important;\n    font-size: 7.8px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__icon {\n    width: 21px !important;\n    height: 21px !important;\n    min-width: 21px !important;\n    flex-basis: 21px !important;\n    font-size: 13px !important;\n    line-height: 21px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__price {\n    font-size: 5.6px !important;\n  }\n\n  #crinea-comparison .crinea-comparison__price strong {\n    font-size: 6.4px !important;\n  }\n}\n</style>",
