inea-comparison__product\">\n              <div class=\"crinea-comparison__product-image-box\">\n                <img\n                  src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/rasoir_crinea.png?v=1785581729\"\n                  alt=\"Rasoir Crinéa\"\n                  class=\"crinea-comparison__product-image\"\n                  loading=\"lazy\"\n                  width=\"168\"\n                  height=\"152\"\n                >\n              </div>\n\n              <p class=\"crinea-comparison__product-name\">\n                Rasoir Crinéa\n              </p>\n            </div>\n          </div>\n\n          <!-- RASOIRS JETABLES -->\n          <div class=\"crinea-comparison__column-head\">\n            <div class=\"crinea-comparison__product\">\n              <div class=\"crinea-comparison__product-image-box\">\n                <img\n                  src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/RASOIR_JETANBLE.png?v=1785583000\"\n                  alt=\"Rasoirs jetables\"\n                  class=\"crinea-comparison__product-image\"\n                  loading=\"lazy\"\n                  width=\"168\"\n                  height=\"152\"\n                >\n              </div>\n\n              <p class=\"crinea-comparison__product-name\">\n                Rasoirs jetables\n              </p>\n            </div>\n          </div>\n\n          <!-- CIRE -->\n          <div class=\"crinea-comparison__column-head\">\n            <div class=\"crinea-comparison__product\">\n              <div class=\"crinea-comparison__product-image-box\">\n                <img\n                  src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/CIRE.png?v=1785582988\"\n                  alt=\"Épilation à la cire\"\n                  class=\"crinea-comparison__product-image\"\n                  loading=\"lazy\"\n                  width=\"168\"\n                  height=\"152\"\n                >\n              </div>\n\n              <p class=\"crinea-comparison__product-name\">\n                Épilation à la cire\n              </p>\n            </div>\n          </div>\n\n        </div>\n\n        <!-- RASAGE DOUX -->\n        <div class=\"crinea-comparison__grid crinea-comparison__row\">\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--label\">\n            Rasage doux pour les zones sensibles\n          </div>\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--featured\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--featured\"\n              aria-label=\"Oui\"\n            >✓</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--no\"\n              aria-label=\"Non\"\n            >×</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--no\"\n              aria-label=\"Non\"\n            >×</span>\n          </div>\n\n        </div>\n\n        <!-- UTILISATION -->\n        <div class=\"crinea-comparison__grid crinea-comparison__row\">\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--label\">\n            Utilisable à domicile, à tout moment\n          </div>\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--featured\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--featured\"\n              aria-label=\"Oui\"\n            >✓</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--yes\"\n              aria-label=\"Oui\"\n            >✓</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--no\"\n              aria-label=\"Non\"\n            >×</span>\n          </div>\n\n        </div>\n\n        <!-- PRIX -->\n        <div class=\"crinea-comparison__grid crinea-comparison__row\">\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--label\">\n            Prix\n          </div>\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--featured\">\n            <div class=\"crinea-comparison__price\">\n              <strong>34,99 €</strong>\n              en une fois\n            </div>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <div class=\"crinea-comparison__price\">\n              Achats réguliers\n              <strong>et répétés</strong>\n            </div>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <div class=\"crinea-comparison__price\">\n              Jusqu’à\n              <strong>30 € par séance</strong>\n            </div>\n          </div>\n\n        </div>\n\n        <!-- RÉSULTATS IMMÉDIATS -->\n        <div class=\"crinea-comparison__grid crinea-comparison__row\">\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--label\">\n            Résultats immédiats\n          </div>\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--featured\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--featured\"\n              aria-label=\"Oui\"\n            >✓</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--yes\"\n              aria-label=\"Oui\"\n            >✓</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--yes\"\n              aria-label=\"Oui\"\n            >✓</span>\n          </div>\n\n        </div>\n\n        <!-- PEAUX SENSIBLES -->\n        <div class=\"crinea-comparison__grid crinea-comparison__row\">\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--label\">\n            Conçu pour les zones sensibles\n          </div>\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--featured\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--featured\"\n              aria-label=\"Oui\"\n            >✓</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--no\"\n              aria-label=\"Non\"\n            >×</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--no\"\n              aria-label=\"Non\"\n            >×</span>\n          </div>\n\n        </div>\n\n        <!-- GARANTIE -->\n        <div class=\"crinea-comparison__grid crinea-comparison__row\">\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--label\">\n            Garantie satisfait ou remboursé pendant 30 jours\n          </div>\n\n          <div class=\"crinea-comparison__cell crinea-comparison__cell--featured\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--featured\"\n              aria-label=\"Oui\"\n            >✓</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--no\"\n              aria-label=\"Non\"\n            >×</span>\n          </div>\n\n          <div class=\"crinea-comparison__cell\">\n            <span\n              class=\"crinea-comparison__icon crinea-comparison__icon--no\"\n              aria-label=\"Non\"\n            >×</span>\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n\n    <p class=\"crinea-comparison__note\">\n      Comparaison indicative. Le coût, le confort et les résultats peuvent\n      varier selon les produits utilisés, les instituts et la sensibilité de\n      chaque personne.\n    </p>\n\n  </div>\n</section>",
