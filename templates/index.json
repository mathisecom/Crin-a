    font-weight: 700;\n  }\n\n  @media screen and (max-width: 480px) {\n    .delivery-box {\n      gap: 9px;\n      padding: 10px 11px;\n    }\n\n    .delivery-icon {\n      flex-basis: 35px;\n      width: 35px;\n      height: 35px;\n    }\n\n    .delivery-heading {\n      font-size: 12px;\n    }\n\n    .delivery-delay {\n      font-size: 10.5px;\n    }\n  }\n</style>"
