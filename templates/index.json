        "liquid": "<style>\n  #crinea-benefits {\n    --crinea-dark: #2f201b;\n    --crinea-text: #65534b;\n    --crinea-accent: #c99f8e;\n    --crinea-white: #ffffff;\n    --crinea-border: #e4dbd6;\n\n    width: 100%;\n    padding: 58px 20px 65px;\n    overflow: hidden;\n    background: #ffffff;\n    color: var(--crinea-dark);\n    font-family: inherit;\n  }\n\n  #crinea-benefits * {\n    box-sizing: border-box;\n  }\n\n  #crinea-benefits .crinea-benefits__container {\n    width: 100%;\n    max-width: 1500px;\n    margin: 0 auto;\n  }\n\n  #crinea-benefits .crinea-benefits__header {\n    max-width: 950px;\n    margin: 0 auto 38px;\n    text-align: center;\n  }\n\n  #crinea-benefits .crinea-benefits__label {\n    display: inline-block;\n    margin-bottom: 10px;\n    color: var(--crinea-accent);\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n  }\n\n  #crinea-benefits .crinea-benefits__title {\n    margin: 0;\n    color: var(--crinea-dark);\n    font-size: clamp(29px, 4vw, 44px);\n    font-weight: 500;\n    line-height: 1.18;\n    letter-spacing: -0.8px;\n  }\n\n  #crinea-benefits .crinea-benefits__title strong {\n    color: #8f634d;\n    font-family: Georgia, serif;\n    font-style: italic;\n    font-weight: 500;\n  }\n\n  #crinea-benefits .crinea-benefits__viewport {\n    width: 100%;\n    overflow: hidden;\n  }\n\n  #crinea-benefits .crinea-benefits__track {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 24px;\n  }\n\n  #crinea-benefits .crinea-benefits__card {\n    min-width: 0;\n    overflow: hidden;\n    border: 1px solid var(--crinea-border);\n    border-radius: 9px;\n    background: var(--crinea-white);\n    box-shadow: 0 8px 25px rgba(47, 32, 27, 0.06);\n    transition:\n      transform 0.3s ease,\n      box-shadow 0.3s ease;\n  }\n\n  #crinea-benefits .crinea-benefits__card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 14px 32px rgba(47, 32, 27, 0.1);\n  }\n\n  #crinea-benefits .crinea-benefits__media {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    overflow: hidden;\n    background: #f5efeb;\n  }\n\n  #crinea-benefits .crinea-benefits__image {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    transition: transform 0.4s ease;\n  }\n\n  #crinea-benefits .crinea-benefits__card:hover .crinea-benefits__image {\n    transform: scale(1.025);\n  }\n\n  #crinea-benefits .crinea-benefits__content {\n    min-height: 190px;\n    padding: 22px 20px 25px;\n    background: #ffffff;\n  }\n\n  #crinea-benefits .crinea-benefits__card-title {\n    margin: 0 0 9px;\n    color: var(--crinea-dark);\n    font-size: 20px;\n    font-weight: 800;\n    line-height: 1.25;\n  }\n\n  #crinea-benefits .crinea-benefits__text {\n    margin: 0;\n    color: var(--crinea-text);\n    font-size: 14px;\n    line-height: 1.58;\n  }\n\n  #crinea-benefits .crinea-benefits__navigation {\n    display: none;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    margin-top: 24px;\n  }\n\n  #crinea-benefits .crinea-benefits__button {\n    width: 42px;\n    height: 42px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n    border: 1px solid var(--crinea-border);\n    border-radius: 50%;\n    background: #ffffff;\n    color: var(--crinea-dark);\n    cursor: pointer;\n    box-shadow: 0 4px 15px rgba(47, 32, 27, 0.08);\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  #crinea-benefits .crinea-benefits__button:hover {\n    background: #f7efeb;\n    transform: translateY(-2px);\n  }\n\n  #crinea-benefits .crinea-benefits__button svg {\n    width: 19px;\n    height: 19px;\n    display: block;\n  }\n\n  @media screen and (max-width: 1100px) {\n    #crinea-benefits .crinea-benefits__track {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #crinea-benefits {\n      padding: 42px 0 45px;\n      background: #ffffff;\n    }\n\n    #crinea-benefits .crinea-benefits__header {\n      margin-bottom: 25px;\n      padding: 0 18px;\n    }\n\n    #crinea-benefits .crinea-benefits__label {\n      margin-bottom: 7px;\n      font-size: 9px;\n      letter-spacing: 1.5px;\n    }\n\n    #crinea-benefits .crinea-benefits__title {\n      font-size: 27px;\n      line-height: 1.15;\n    }\n\n    #crinea-benefits .crinea-benefits__viewport {\n      overflow-x: auto;\n      padding: 0 16px 8px;\n      scroll-behavior: smooth;\n      scroll-snap-type: x mandatory;\n      scrollbar-width: none;\n      -webkit-overflow-scrolling: touch;\n    }\n\n    #crinea-benefits .crinea-benefits__viewport::-webkit-scrollbar {\n      display: none;\n    }\n\n    #crinea-benefits .crinea-benefits__track {\n      display: flex;\n      width: max-content;\n      gap: 14px;\n    }\n\n    #crinea-benefits .crinea-benefits__card {\n      width: calc(100vw - 55px);\n      max-width: 360px;\n      flex: 0 0 calc(100vw - 55px);\n      scroll-snap-align: center;\n      border-radius: 8px;\n    }\n\n    #crinea-benefits .crinea-benefits__media {\n      aspect-ratio: 1 / 1;\n    }\n\n    #crinea-benefits .crinea-benefits__content {\n      min-height: 172px;\n      padding: 18px 17px 21px;\n    }\n\n    #crinea-benefits .crinea-benefits__card-title {\n      margin-bottom: 7px;\n      font-size: 18px;\n    }\n\n    #crinea-benefits .crinea-benefits__text {\n      font-size: 13px;\n      line-height: 1.5;\n    }\n\n    #crinea-benefits .crinea-benefits__navigation {\n      display: flex;\n      margin-top: 18px;\n    }\n\n    #crinea-benefits .crinea-benefits__button {\n      width: 38px;\n      height: 38px;\n    }\n  }\n</style>\n\n<section id=\"crinea-benefits\">\n  <div class=\"crinea-benefits__container\">\n\n    <header class=\"crinea-benefits__header\">\n      <span class=\"crinea-benefits__label\">\n        Douceur, précision et simplicité\n      </span>\n\n      <h2 class=\"crinea-benefits__title\">\n        Pourquoi les femmes abandonnent leurs rasoirs pour\n        <strong>Crinéa</strong>\n      </h2>\n    </header>\n\n    <div\n      class=\"crinea-benefits__viewport\"\n      id=\"crinea-benefits-viewport\"\n    >\n      <div class=\"crinea-benefits__track\">\n\n        <!-- CARTE 1 -->\n        <article class=\"crinea-benefits__card\">\n          <div class=\"crinea-benefits__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_49_nonickgif.gif?v=1785583730\"\n              alt=\"Rasage doux avec Crinéa\"\n              class=\"crinea-benefits__image\"\n              loading=\"lazy\"\n              width=\"700\"\n              height=\"700\"\n            >\n          </div>\n\n          <div class=\"crinea-benefits__content\">\n            <h3 class=\"crinea-benefits__card-title\">\n              Moins de coupures\n            </h3>\n\n            <p class=\"crinea-benefits__text\">\n              Sa tête de protection est conçue pour glisser délicatement sur\n              la peau et limiter le contact direct avec les bords de coupe.\n              Une utilisation plus douce, notamment sur les zones délicates.\n            </p>\n          </div>\n        </article>\n\n        <!-- CARTE 2 -->\n        <article class=\"crinea-benefits__card\">\n          <div class=\"crinea-benefits__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_50_smothshavegif.gif?v=1785583745\"\n              alt=\"Rasage rapide avec Crinéa\"\n              class=\"crinea-benefits__image\"\n              loading=\"lazy\"\n              width=\"700\"\n              height=\"700\"\n            >\n          </div>\n\n          <div class=\"crinea-benefits__content\">\n            <h3 class=\"crinea-benefits__card-title\">\n              Rasez-vous en quelques minutes\n            </h3>\n\n            <p class=\"crinea-benefits__text\">\n              Couvrez rapidement de grandes zones comme les jambes et les\n              aisselles. Une routine simple et pratique qui vous fait gagner\n              du temps au quotidien.\n            </p>\n          </div>\n        </article>\n\n        <!-- CARTE 3 -->\n        <article class=\"crinea-benefits__card\">\n          <div class=\"crinea-benefits__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_52_imgi_28_2.webp?v=1785583783\"\n              alt=\"Peau plus lisse après utilisation de Crinéa\"\n              class=\"crinea-benefits__image\"\n              loading=\"lazy\"\n              width=\"700\"\n              height=\"700\"\n            >\n          </div>\n\n          <div class=\"crinea-benefits__content\">\n            <h3 class=\"crinea-benefits__card-title\">\n              Aide à limiter les poils incarnés\n            </h3>\n\n            <p class=\"crinea-benefits__text\">\n              La tête coupe les poils au niveau de la peau sans les arracher.\n              Une méthode douce qui aide à limiter les irritations et la\n              repousse des poils sous la peau.\n            </p>\n          </div>\n        </article>\n\n        <!-- CARTE 4 -->\n        <article class=\"crinea-benefits__card\">\n          <div class=\"crinea-benefits__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_53_freecompress-a_9e0a0558-b83f-4e83-a362-c8a6932bbbe8.jpg?v=1785583854\"\n              alt=\"Utilisation du rasoir Crinéa sur la ligne du maillot\"\n              class=\"crinea-benefits__image\"\n              loading=\"lazy\"\n              width=\"700\"\n              height=\"700\"\n            >\n          </div>\n\n          <div class=\"crinea-benefits__content\">\n            <h3 class=\"crinea-benefits__card-title\">\n              Idéal pour la ligne du maillot\n            </h3>\n\n            <p class=\"crinea-benefits__text\">\n              Sa forme épouse les courbes du corps et facilite le passage sur\n              les zones délicates. Pour une finition précise, douce et\n              confortable.\n            </p>\n          </div>\n        </article>\n\n      </div>\n    </div>\n\n    <div class=\"crinea-benefits__navigation\">\n\n      <button\n        type=\"button\"\n        class=\"crinea-benefits__button\"\n        id=\"crinea-benefits-prev\"\n        aria-label=\"Voir la carte précédente\"\n      >\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path\n            d=\"M15 5L8 12L15 19\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n      </button>\n\n      <button\n        type=\"button\"\n        class=\"crinea-benefits__button\"\n        id=\"crinea-benefits-next\"\n        aria-label=\"Voir la carte suivante\"\n      >\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path\n            d=\"M9 5L16 12L9 19\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n      </button>\n\n    </div>\n\n  </div>\n</section>\n\n<script>\n  function initCrineaBenefits() {\n    const viewport = document.getElementById(\"crinea-benefits-viewport\");\n    const previousButton = document.getElementById(\"crinea-benefits-prev\");\n    const nextButton = document.getElementById(\"crinea-benefits-next\");\n\n    if (!viewport || !previousButton || !nextButton) return;\n\n    if (viewport.dataset.initialized === \"true\") return;\n    viewport.dataset.initialized = \"true\";\n\n    function getScrollAmount() {\n      const card = viewport.querySelector(\".crinea-benefits__card\");\n\n      if (!card) {\n        return viewport.clientWidth;\n      }\n\n      return card.getBoundingClientRect().width + 14;\n    }\n\n    previousButton.addEventListener(\"click\", function () {\n      viewport.scrollBy({\n        left: -getScrollAmount(),\n        behavior: \"smooth\"\n      });\n    });\n\n    nextButton.addEventListener(\"click\", function () {\n      viewport.scrollBy({\n        left: getScrollAmount(),\n        behavior: \"smooth\"\n      });\n    });\n  }\n\n  document.addEventListener(\"DOMContentLoaded\", initCrineaBenefits);\n  document.addEventListener(\"shopify:section:load\", initCrineaBenefits);\n\n  initCrineaBenefits();\n</script>",
