ize: 22px;\n      margin-bottom: 8px;\n    }\n\n    .crinea-step-text {\n      font-size: 15px;\n      line-height: 1.5;\n    }\n  }\n</style>\n\n<section class=\"crinea-steps-section\">\n  <div class=\"crinea-steps-container\">\n\n    <div class=\"crinea-steps-grid\">\n\n      <!-- Étape 1 -->\n      <div class=\"crinea-step-card\">\n        <div class=\"crinea-step-image-wrap\">\n          <div class=\"crinea-step-badge\">Étape 1</div>\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_46_imgi_146_G7A6853.jpg?v=1785582333\"\n            alt=\"Étape 1 Crinéa\"\n            class=\"crinea-step-image\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"600\"\n          >\n        </div>\n\n        <h3 class=\"crinea-step-title\">Choisissez la tête</h3>\n        <p class=\"crinea-step-text\">\n          La tête de coupe centrale en aluminium capture les poils courts et\n          les coupe au ras de la peau. L’aluminium ultra-fin garantit une peau\n          parfaitement lisse et sans irritation.\n        </p>\n      </div>\n\n      <!-- Étape 2 -->\n      <div class=\"crinea-step-card\">\n        <div class=\"crinea-step-image-wrap\">\n          <div class=\"crinea-step-badge\">Étape 2</div>\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_51_G7A6879_631a1d22-ef0d-4f70-8f32-e5cfae1c0c05.jpg?v=1785582381\"\n            alt=\"Étape 2 Crinéa\"\n            class=\"crinea-step-image\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"600\"\n          >\n        </div>\n\n        <h3 class=\"crinea-step-title\">Tondeuse</h3>\n        <p class=\"crinea-step-text\">\n          Les deux têtes de tondeuse de précision s’attaquent d’abord aux\n          poils les plus longs ou les plus épais. Elles préparent la peau pour\n          un rasage ensuite doux et sans effort.\n        </p>\n      </div>\n\n      <!-- Étape 3 -->\n      <div class=\"crinea-step-card\">\n        <div class=\"crinea-step-image-wrap\">\n          <div class=\"crinea-step-badge\">Étape 3</div>\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_47_hf_20260407_041712_8b838bc2-3c59-4940-89b3-9b9a1bc9f445.png?v=1785582351\"\n            alt=\"Étape 3 Crinéa\"\n            class=\"crinea-step-image\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"600\"\n          >\n        </div>\n\n        <h3 class=\"crinea-step-title\">Feuille lisse</h3>\n        <p class=\"crinea-step-text\">\n          Sa tête rotative arrondie épouse les courbes. Utilisez-la en\n          mouvements circulaires sur le maillot, les aisselles ou toute zone\n          sensible pour un rasage impeccable sans coupures.\n        </p>\n      </div>\n\n      <!-- Étape 4 -->\n      <div class=\"crinea-step-card\">\n        <div class=\"crinea-step-image-wrap\">\n          <div class=\"crinea-step-badge\">Étape 4</div>\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1034/1403/8862/files/imgi_48_freecompress-G7A6773_84d43164-79ac-4c54-8e6e-6ef8194a60a7.jpg?v=1785582364\"\n            alt=\"Étape 4 Crinéa\"\n            class=\"crinea-step-image\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"600\"\n          >\n        </div>\n\n        <h3 class=\"crinea-step-title\">Rotatif pour un toucher doux et délicat</h3>\n        <p class=\"crinea-step-text\">\n          La tête rotative douce glisse sur les courbes, offrant un rasage\n          lisse et sans coupures sur les zones délicates avec une précision\n          sans effort.\n        </p>\n      </div>\n\n    </div>\n\n  </div>\n</section>",
